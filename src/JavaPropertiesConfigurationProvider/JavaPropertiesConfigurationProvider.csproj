<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Microsoft.Extensions.Configuration.JavaProperties</RootNamespace>
    <AssemblyName>JavaPropertiesConfigurationProvider</AssemblyName>

    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>JavaPropertiesConfigurationProvider</PackageId>
    <Version>1.0.0</Version>
    <Description>A high-performance Java .properties parser, writer, and Microsoft.Extensions.Configuration provider for .NET.</Description>
    <Authors>JavaPropertiesConfigurationProvider Contributors</Authors>
    <PackageTags>java;properties;configuration;parser;utf8</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>JavaPropertiesConfigurationProvider.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>JavaPropertiesConfigurationProvider.Benchmarks</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
